{
  "schema_version": 1,
  "defaults": {
    "lookback_days": 180,
    "stale_issue_days": 120,
    "max_closed_pull_requests": 100,
    "max_candidates_per_repository": 10
  },
  "interests": [
    "computer vision",
    "model compression",
    "quantization",
    "pruning",
    "inference",
    "deployment",
    "CUDA",
    "PyTorch",
    "Python",
    "C++",
    "transformers",
    "evaluation",
    "documentation"
  ],
  "repositories": [

      "guide": "https://github.com/google-gemini/cookbook/blob/main/CONTRIBUTING.md"
    },
    {
      "repo": "google/adk-python",
      "group": "company",
      "guide": "https://github.com/google/adk-python/blob/main/CONTRIBUTING.md",
